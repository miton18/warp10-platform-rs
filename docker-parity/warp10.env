# Shared Warp 10 distributed config for the parity cluster (DEV KEYS ONLY —
# never use these outside local docker). Values are hex:... as WarpConfig expects.
warp10.instance=parity
class.hash.key=hex:0102030405060708090a0b0c0d0e0f10
labels.hash.key=hex:1112131415161718191a1b1c1d1e1f20
token.hash.key=hex:2122232425262728292a2b2c2d2e2f30
app.hash.key=hex:3132333435363738393a3b3c3d3e3f40
token.aes.key=hex:4142434445464748494a4b4c4d4e4f50
scripts.aes.key=hex:5152535455565758595a5b5c5d5e5f60
aes.key=hex:6162636465666768696a6b6c6d6e6f70
hash.key=hex:7172737475767778797a7b7c7d7e7f70
mac.key=hex:8182838485868788898a8b8c8d8e8f90
logging.aes.key=hex:9192939495969798999a9b9c9d9e9f90
metasets.aes.key=hex:a1a2a3a4a5a6a7a8a9aaabacadaeafb0
directory.hash.key=hex:b1b2b3b4b5b6b7b8b9babbbcbdbebfc0
fetch.hash.key=hex:c1c2c3c4c5c6c7c8c9cacbcccdcecfd0
fdb.clusterfile=/fdb.cluster
fdb.data.aes=hex:d1d2d3d4d5d6d7d8d9dadbdcdddedfd0
fdb.metadata.aes=hex:e1e2e3e4e5e6e7e8e9eaebecedeeef00
kafka.data.topic=warp10-data
kafka.metadata.topic=warp10-meta
kafka.data.bootstrap.servers=localhost:9092
kafka.metadata.bootstrap.servers=localhost:9092
kafka.bootstrap.servers=localhost:9092
zk.quorum=localhost:2181
JAVA_OPTS=-Xmx2g -XX:+UseG1GC
ingress.kafka.metadata.consumer.auto.offset.reset=earliest
directory.kafka.metadata.consumer.auto.offset.reset=earliest
store.kafka.data.consumer.conf.prefix.auto.offset.reset=earliest
